#!/bin/sh
set -euf

# Zypper package manager for openSUSE
#
# Zypper is the command-line package manager for openSUSE and SUSE Linux Enterprise.
# This script updates all installed packages to their latest versions.
#
# Options used:
# - up: Update all installed packages
# - --no-confirm: Run non-interactively (don't ask for confirmation)
# - --auto-agree-with-licenses: Automatically agree to license agreements
#
if command -v zypper >/dev/null 2>&1; then
    echo "Updating packages via zypper..."

    # Refresh repositories first
    zypper refresh

    # Update all packages
    zypper --non-interactive --auto-agree-with-licenses update

    # Clean up package cache to save disk space
    zypper clean --all

    echo "zypper update completed."
else
    echo "zypper not found, skipping zypper updates."
fi
